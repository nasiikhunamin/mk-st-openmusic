# Database connection string (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://openmusic:openmusic@localhost:5432/openmusic

# Redis connection string for caching
REDIS_URL=redis://localhost:6379/0

# Secret key for JWT signing (generate a strong one for production, e.g., using `openssl rand -hex 32`)
SECRET_KEY=your-secret-key-here-change-in-production

# Jamendo API Client ID (required for tracks/search and streaming)
JAMENDO_CLIENT_ID=your-jamendo-client-id

# Last.fm API Key (required for similar tracks/recommendations)
LASTFM_API_KEY=your-lastfm-api-key

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
